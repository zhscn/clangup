# Read JSON lines without splitting on CMake list separators inside strings.
macro(next_cargo_message)
  string(FIND "${stream}" "\n" newline)
  if(newline EQUAL -1)
    set(msg "${stream}")
    set(stream "")
  else()
    string(SUBSTRING "${stream}" 0 "${newline}" msg)
    math(EXPR offset "${newline} + 1")
    string(SUBSTRING "${stream}" "${offset}" -1 stream)
  endif()
  string(JSON reason ERROR_VARIABLE parse_error GET "${msg}" reason)
endmacro()

file(READ "${out}/cargo.jsonl" stream)
while(NOT stream STREQUAL "")
  next_cargo_message()
  if(parse_error)
    continue()
  endif()
  if(reason STREQUAL "compiler-message")
    string(JSON rendered GET "${msg}" message rendered)
    if(rendered)
      message("${rendered}")
    endif()
  elseif(reason STREQUAL "compiler-artifact")
    string(JSON package GET "${msg}" package_id)
    string(SHA256 last_key "${package}")
    string(JSON target GET "${msg}" target name)
    if(NOT DEFINED expected_lib OR expected_lib STREQUAL target)
      string(JSON filenames GET "${msg}" filenames)
      string(JSON count LENGTH "${filenames}")
      if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE "${last}")
          string(JSON filename GET "${filenames}" "${index}")
          get_filename_component(basename "${filename}" NAME)
          if(basename STREQUAL "lib${target}.a" OR basename STREQUAL "${target}.lib")
            list(APPEND "archives_${last_key}" "${filename}")
          endif()
        endforeach()
      endif()
    endif()
  endif()
endwhile()
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Cargo build failed (${status})")
endif()
set(archives "${archives_${last_key}}")
list(REMOVE_DUPLICATES archives)
list(LENGTH archives count)
if(count EQUAL 0)
  message(FATAL_ERROR "Cargo did not produce the selected staticlib. Check the crate type and lib-name if set.")
elseif(count GREATER 1)
  message(FATAL_ERROR "Cargo built multiple staticlibs for the selected package. Select one target in cmk.yaml.")
endif()
list(GET archives 0 artifact)
set(staged "${out}/${archive}")
set(previous_artifact "")
if(IS_SYMLINK "${staged}")
  file(READ_SYMLINK "${staged}" previous_artifact)
endif()
if(NOT previous_artifact STREQUAL artifact)
  # Keep CMake's stable archive path without duplicating Cargo's archive.
  file(CREATE_LINK "${artifact}" "${staged}" SYMBOLIC RESULT link_status)
  if(NOT link_status STREQUAL "0")
    configure_file("${artifact}" "${staged}" COPYONLY)
  endif()
endif()
