# Cargo prints the native libraries for the selected staticlib as rustc
# diagnostics. It also replays these messages for a fresh (cached) artifact.
# Read JSON lines without splitting on CMake list separators inside strings.
macro(next_cargo_message)
  string(FIND "${stream}" "\n" newline)
  if(newline EQUAL -1)
    set(msg "${stream}")
    set(stream "")
  else()
    string(SUBSTRING "${stream}" 0 "${newline}" msg)
    math(EXPR offset "${newline} + 1")
    string(SUBSTRING "${stream}" "${offset}" -1 stream)
  endif()
  string(JSON reason ERROR_VARIABLE parse_error GET "${msg}" reason)
endmacro()

file(READ "${out}/cargo.jsonl" stream)
set(search_messages "")
set(native_args "")
while(NOT stream STREQUAL "")
  next_cargo_message()
  if(parse_error)
    continue()
  endif()
  if(reason STREQUAL "compiler-message")
    string(JSON text GET "${msg}" message message)
    if(text MATCHES "^native-static-libs: *(.*)$")
      set(native_args "${CMAKE_MATCH_1}")
      string(JSON native_package GET "${msg}" package_id)
      string(SHA256 native_key "${native_package}")
    elseif(NOT text MATCHES "^link against the following native artifacts")
      string(JSON rendered GET "${msg}" message rendered)
      if(rendered)
        message("${rendered}")
      endif()
    endif()
  elseif(reason STREQUAL "compiler-artifact")
    string(JSON package GET "${msg}" package_id)
    string(SHA256 last_key "${package}")
    string(JSON manifest GET "${msg}" manifest_path)
    get_filename_component("package_dir_${last_key}" "${manifest}" DIRECTORY)
    string(JSON target GET "${msg}" target name)
    if(NOT DEFINED expected_lib OR expected_lib STREQUAL target)
      string(JSON filenames GET "${msg}" filenames)
      string(JSON count LENGTH "${filenames}")
      if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE "${last}")
          string(JSON filename GET "${filenames}" "${index}")
          get_filename_component(basename "${filename}" NAME)
          if(basename STREQUAL "lib${target}.a" OR basename STREQUAL "${target}.lib")
            list(APPEND "archives_${last_key}" "${filename}")
            string(JSON "fresh_${last_key}" GET "${msg}" fresh)
          endif()
        endforeach()
      endif()
    endif()
  elseif(reason STREQUAL "build-script-executed")
    string(APPEND search_messages "${msg}\n")
  endif()
endwhile()
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Cargo build failed (${status})")
endif()
# A crate with an empty native link list can omit the diagnostic. Cargo
# reports the selected package after its dependencies.
if(DEFINED native_key)
  set(last_key "${native_key}")
endif()
set(archives "${archives_${last_key}}")
list(REMOVE_DUPLICATES archives)
list(LENGTH archives count)
if(count EQUAL 0)
  message(FATAL_ERROR "Cargo did not produce the selected staticlib. Check the crate type and lib-name if set.")
elseif(count GREATER 1)
  message(FATAL_ERROR "Cargo built multiple staticlibs for the selected package. Select one target in cmk.yaml.")
endif()
list(GET archives 0 artifact)
set(staged "${out}/${archive}")
set(previous_artifact "")
if(IS_SYMLINK "${staged}")
  file(READ_SYMLINK "${staged}" previous_artifact)
endif()
set(archive_retargeted FALSE)
if(NOT previous_artifact STREQUAL artifact)
  # Keep CMake's stable archive path without duplicating Cargo's archive.
  file(CREATE_LINK "${artifact}" "${staged}" SYMBOLIC RESULT link_status)
  if(link_status STREQUAL "0")
    set(archive_retargeted TRUE)
  else()
    configure_file("${artifact}" "${staged}" COPYONLY)
  endif()
endif()

# Cargo's build-script search paths supplement the native library names. On
# cross-target builds the host can have build scripts too, with paths that
# must stay out of the C++ target link.
get_filename_component(artifact_dir "${artifact}" DIRECTORY)
get_filename_component(profile "${artifact_dir}" NAME)
set(host_dir "${out}/cargo-target/${profile}")
set(search_args)
set(stream "${search_messages}")
while(NOT stream STREQUAL "")
  next_cargo_message()
  string(JSON build_out GET "${msg}" out_dir)
  string(FIND "${build_out}" "${host_dir}/" host_prefix)
  if(NOT artifact_dir STREQUAL host_dir AND host_prefix EQUAL 0)
    continue()
  endif()
  string(JSON package GET "${msg}" package_id)
  string(SHA256 key "${package}")
  set(base "${package_dir_${key}}")
  if(NOT base)
    set(base "${cargo_dir}")
  endif()
  string(JSON count LENGTH "${msg}" linked_paths)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE "${last}")
      string(JSON path GET "${msg}" linked_paths "${index}")
      set(flag "-L")
      if(path MATCHES "^framework=(.*)$")
        set(flag "-F")
        set(path "${CMAKE_MATCH_1}")
      elseif(path MATCHES "^(native|all)=(.*)$")
        set(path "${CMAKE_MATCH_2}")
      elseif(path MATCHES "^[a-z]+=")
        continue()
      endif()
      if(msvc)
        set(flag "/LIBPATH:")
      endif()
      get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${base}")
      list(APPEND search_args "${flag}${path}")
    endforeach()
  endif()
endwhile()
list(REMOVE_DUPLICATES search_args)

separate_arguments(native_args UNIX_COMMAND "${native_args}")
# CMake's selected C++ toolchain supplies its own C++ standard library.
list(REMOVE_ITEM native_args "-lstdc++" "-lc++")
set(response "")
foreach(arg IN LISTS search_args native_args)
  # Quote each argument for the linker while preserving order and repetition.
  string(REPLACE "\\" "\\\\" arg "${arg}")
  string(REPLACE "\"" "\\\"" arg "${arg}")
  string(APPEND response "\"${arg}\"\n")
endforeach()
file(WRITE "${out}/native-libs.tmp" "${response}")
configure_file("${out}/native-libs.tmp" "${out}/native-libs.rsp" COPYONLY)
file(REMOVE "${out}/native-libs.tmp")
# A build script can update an unbundled native archive while the Rust archive
# and link arguments stay byte-identical. A rebuilt crate still needs relinking.
if(archive_retargeted OR NOT fresh_${last_key})
  file(TOUCH "${out}/native-libs.rsp")
endif()
