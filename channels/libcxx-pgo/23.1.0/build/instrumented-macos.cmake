# Throwaway IR-instrumented macOS compiler used to collect the PGO profile.

set(CMAKE_INSTALL_PREFIX "$ENV{CLANGUP_INSTRUMENTED_PREFIX}" CACHE PATH "" FORCE)
set(LLVM_ENABLE_PROJECTS "clang" CACHE STRING "" FORCE)
set(LLVM_ENABLE_RUNTIMES "" CACHE STRING "" FORCE)
set(LLVM_BUILD_INSTRUMENTED IR CACHE STRING "" FORCE)
set(LLVM_PROFILE_DATA_DIR "$ENV{CLANGUP_PGO_DIR}" CACHE PATH "" FORCE)
set(LLVM_BUILD_RUNTIME OFF CACHE BOOL "" FORCE)
