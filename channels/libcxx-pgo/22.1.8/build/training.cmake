# LLVM source build used as the PGO and BOLT workload.

set(CMAKE_BUILD_TYPE "$ENV{CLANGUP_TRAIN_BUILD_TYPE}" CACHE STRING "" FORCE)
set(CMAKE_C_COMPILER "$ENV{CLANGUP_TRAIN_CC}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "$ENV{CLANGUP_TRAIN_CXX}" CACHE FILEPATH "" FORCE)
set(CMAKE_AR "$ENV{CLANGUP_TRAIN_AR}" CACHE FILEPATH "" FORCE)
set(CMAKE_NM "$ENV{CLANGUP_TRAIN_NM}" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "$ENV{CLANGUP_TRAIN_RANLIB}" CACHE FILEPATH "" FORCE)
set(CMAKE_C_FLAGS "" CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS "" CACHE STRING "" FORCE)

set(LLVM_ENABLE_PROJECTS "clang;lld" CACHE STRING "" FORCE)
set(LLVM_TARGETS_TO_BUILD "$ENV{CLANGUP_LLVM_TARGETS}" CACHE STRING "" FORCE)
set(LLVM_DEFAULT_TARGET_TRIPLE "$ENV{CLANGUP_TARGET_TRIPLE}" CACHE STRING "" FORCE)
set(LLVM_ENABLE_ASSERTIONS OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_LIBEDIT OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_LIBXML2 OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_ZLIB OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_ZSTD OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_LLD ON CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_BENCHMARKS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_DOCS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_TESTS OFF CACHE BOOL "" FORCE)
set(CLANG_INCLUDE_TESTS OFF CACHE BOOL "" FORCE)
